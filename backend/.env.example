# Template only. The Dart server does not automatically load this file.
# Replace every value marked GENERATE/REPLACE before starting the API.
APP_ENV=development
API_BIND_HOST=127.0.0.1
API_PORT=8787
PUBLIC_SITE_URL=https://www.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Generate independent random values; never commit real values.
ADMIN_2FA_CODE=REPLACE_WITH_PRIVATE_CODE
ADMIN_BOOTSTRAP_TOKEN=GENERATE_AT_LEAST_32_RANDOM_BYTES
DOWNLOAD_SIGNING_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES

# Admin login OTP delivery through Gmail SMTP. Use a Google App Password,
# not the account's regular password. Keep these values outside source control.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_GMAIL_ADDRESS
SMTP_APP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=REPLACE_WITH_GMAIL_ADDRESS
SMTP_FROM_NAME=Magelang Ekspres

# Optional until a publisher-owned Midtrans merchant account is configured.
# Use a sandbox server key for development, a production key only after
# MIDTRANS_IS_PRODUCTION=true and the public HTTPS webhook is configured.
MIDTRANS_SERVER_KEY=REPLACE_WITH_MIDTRANS_SERVER_KEY
MIDTRANS_IS_PRODUCTION=false

# Development defaults to the JSON store. For MySQL set DB_DRIVER=mysql and
# use a dedicated least-privilege account, never root.
DB_DRIVER=json
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=magelang_express
DB_USER=magelang_app
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
